flowchart TD
    %% Định nghĩa các node
    User([Người dùng nhập câu hỏi])
    Classify{Phân loại độ<br>phức tạp}
    
    Simple[Đơn giản: hỏi kiến thức chung,<br>không cần dữ liệu thực tế<br>hoặc hành động]
    Complex[Phức tạp: cần dữ liệu cá nhân/thực tế,<br>nhiều bước hoặc cần gọi tool]
    
    %% Luồng chính
    User --> Classify
    Classify --> Simple
    Classify --> Complex
    
    %% Nối vào các subgraph
    Simple --> BasePrompt
    Complex --> ReActPrompt
    
    %% Subgraph 1: Chatbot path
    subgraph ChatbotPath [Chatbot path - Baseline]
        BasePrompt[Baseline system prompt] --> LLMDirect[LLM trả lời trực tiếp<br>1 lần gọi, không dùng tool]
    end
    
    %% Subgraph 2: ReAct Agent path
    subgraph ReActPath [ReAct Agent path]
        ReActPrompt[ReAct system prompt] --> Thought[Thought<br>Xác định thông tin còn thiếu]
        
        Thought --> HasEvidence{Đã đủ bằng chứng<br>để trả lời?}
        Thought --> MaxIter[Chạm MAX_ITERATIONS<br>hoặc gặp lỗi không phục hồi]
        
        HasEvidence -->|Chưa| ActionNode[Action<br>Chọn tool và tham số]
        ActionNode --> ExecTool[Thực thi tool]
        ExecTool --> Obs[Observation<br>Nhận kết quả thực tế]
        
        %% Vòng lặp quay lại Thought
        Obs --> Thought
        
        HasEvidence -->|Rồi| Final[Final Answer<br>Tổng hợp từ Observation]
        
        MaxIter --> Fallback[Safe fallback]
    end
    
    %% Kết thúc
    Output([Trả kết quả cho người dùng])
    
    LLMDirect --> Output
    Final --> Output
    Fallback --> Output

    %% CSS Styling để giống màu trong file PDF
    style User fill:#e8eaf6,stroke:#3f51b5,stroke-width:2px
    style Output fill:#e8eaf6,stroke:#3f51b5,stroke-width:2px
    style Classify fill:#fff9c4,stroke:#fbc02d,stroke-width:2px
    style HasEvidence fill:#fff9c4,stroke:#fbc02d,stroke-width:2px
    
    style Simple fill:#e0e0e0,stroke:#9e9e9e
    style Complex fill:#e0e0e0,stroke:#9e9e9e
    style MaxIter fill:#e0e0e0,stroke:#9e9e9e
    
    style BasePrompt fill:#e8f5e9,stroke:#4caf50
    style LLMDirect fill:#e8f5e9,stroke:#4caf50
    
    style ReActPrompt fill:#f3e5f5,stroke:#9c27b0
    style Thought fill:#f3e5f5,stroke:#9c27b0
    style ActionNode fill:#f3e5f5,stroke:#9c27b0
    style ExecTool fill:#f3e5f5,stroke:#9c27b0
    style Obs fill:#f3e5f5,stroke:#9c27b0
    style Final fill:#f3e5f5,stroke:#9c27b0
    
    style Fallback fill:#ffebee,stroke:#f44336,stroke-width:2px
    style ChatbotPath fill:#ffffff,stroke:#000000,stroke-width:1px
    style ReActPath fill:#ffffff,stroke:#000000,stroke-width:1px